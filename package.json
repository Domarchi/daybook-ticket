    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
