{
  "name": "daybook-ticket",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --import tsx scripts/check-alert-tracker.test.ts && node --import tsx scripts/check-web-push.test.ts && node scripts/check-web-push-worker.test.mjs && node --import tsx scripts/check-ticket-drafts.test.ts && node --import tsx scripts/check-attachments.test.ts && node --import tsx scripts/check-collaboration-ui.test.ts",
    "check": "npm run lint && npm run test:unit && npm run typecheck && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "owner:invite": "node scripts/provision-owner.mjs",
    "test:access": "tsx scripts/check-access.mjs",
    "test:database": "tsx scripts/check-database.mjs"
  },
  "dependencies": {
