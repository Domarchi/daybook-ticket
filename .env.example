# Valores reales en archivos locales ignorados y en Vercel. Nunca versionarlos.
DATABASE_URL=postgresql://user:password@pooled-host/daybook_ticket?sslmode=verify-full
DIRECT_DATABASE_URL=postgresql://user:password@direct-host/daybook_ticket?sslmode=verify-full
BETTER_AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
DAYBOOK_OWNER_EMAIL=owner@example.com
DAYBOOK_SITE_URL=http://127.0.0.1:5173

# Opcionales. Mantener vacíos durante pruebas.
RESEND_API_KEY=
DAYBOOK_EMAIL_FROM=

# Web Push: generar un par diferente por entorno; la privada solo vive en el servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://daybook-ticket.vercel.app

# Adjuntos: almacenes PRIVADOS diferentes por entorno. Nunca usar NEXT_PUBLIC_ para estos tokens.
# En desarrollo/preview: qa; en Vercel producción: production.
DAYBOOK_BLOB_ENV=qa
DAYBOOK_BLOB_QA_READ_WRITE_TOKEN=
DAYBOOK_BLOB_PRODUCTION_READ_WRITE_TOKEN=
